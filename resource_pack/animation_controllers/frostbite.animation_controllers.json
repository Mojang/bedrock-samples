{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.frostbite.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "arms_idle": "variable.is_holding_left != 1.0 && (!query.is_baby || !query.is_item_equipped(0))"
            },
            {
              "baby_arms_idle": "variable.is_holding_left != 1.0 && query.is_baby && query.is_item_equipped(0)"
            }
          ],
          "transitions": [
            {
              "ranged_attack": "query.property('minecraft:is_ranged_mode') == true && variable.attack_time >= 0.0"
            },
            {
              "melee_attack": "query.property('minecraft:is_ranged_mode') == false && variable.attack_time >= 0.0"
            }
          ]
        },
        "melee_attack": {
          "animations": [
            {
              "zombie_attack_bare_hand": "variable.is_holding_left != 1.0 && (!query.is_baby || !query.is_item_equipped(0))"
            },
            {
              "baby_zombie_attack_bare_hand": "variable.is_holding_left != 1.0 && query.is_baby && query.is_item_equipped(0)"
            }
          ],
          "transitions": [
            {
              "ranged_attack": "query.property('minecraft:is_ranged_mode') == true && variable.attack_time >= 0.0"
            },
            {
              "default": "variable.attack_time < 0.0"
            }
          ]
        },
        "ranged_attack": {
          "animations": [
            {
              "arms_idle": "variable.is_holding_left != 1.0 && (!query.is_baby || !query.is_item_equipped(0))"
            },
            {
              "baby_arms_idle": "variable.is_holding_left != 1.0 && query.is_baby && query.is_item_equipped(0)"
            },
            "ranged_attack_rotations"
          ],
          "transitions": [
            {
              "melee_attack": "query.property('minecraft:is_ranged_mode') == false && variable.attack_time >= 0.0"
            },
            {
              "default": "variable.attack_time < 0.0"
            }
          ]
        }
      }
    }
  }
}
