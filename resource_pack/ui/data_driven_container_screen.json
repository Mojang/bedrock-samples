{
  "namespace": "data_driven_container",

  // Every control specific to data driven block containers is defined in this file. The screen deliberately does
  // not build on the chest screens (`chest_screen.json`) or the pocket container panels (`pocket_containers.json`),
  // so changes to those files never change how data driven containers look. The only controls referenced from
  // outside this file are the shared `common` building blocks that every inventory screen is made of.

  ////---------------------------------------------------------------------------
  //// #region slot grid
  ////---------------------------------------------------------------------------

  "container_grid_item@common.container_item": {
    "$item_collection_name": "container_items"
  },

  // `container_items` is the collection name for ContainerEnumName::LevelEntityContainer, which is what
  // ChestContainerManagerModel registers for a data driven block container. `$container_size` is supplied by
  // ChestScreenController::addStaticScreenVars from the live container, so the grid holds exactly slot_count
  // cells and the last row is left ragged rather than padded out with unusable ones.
  //
  // The width is pinned to nine 18px slots so `grid_rescaling_type` always wraps at nine columns, and the
  // height is "default" so the grid is exactly as tall as the rows it needs.
  "item_grid": {
    "type": "grid",
    "grid_rescaling_type": "horizontal",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 162, "default" ],
    "maximum_grid_items": "$container_size",
    "collection_name": "container_items",
    "grid_item_template": "data_driven_container.container_grid_item",
    "$item_collection_name": "container_items"
  },

  //// #endregion

  ////---------------------------------------------------------------------------
  //// #region desktop panel
  ////---------------------------------------------------------------------------

  "container_label": {
    "type": "label",
    "layer": 2,
    "offset": [ 7, -1 ],
    "size": [ "90%", "default" ],
    "max_size": [ "90%", 10 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "color": "$title_text_color",
    "localize": "$localize_title",
    "enable_profanity_filter": true
  },

  "panel_top_half": {
    "type": "panel",
    "size": "$container_top_half_size",
    "offset": [ 0, 11 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      { "container_label@data_driven_container.container_label": {} },
      {
        "item_grid@data_driven_container.item_grid": {
          "offset": [ 7, 10 ]
        }
      }
    ]
  },

  "selected_item_details@common.selected_item_details": {
    "offset": [ 0, 0 ]
  },

  // The panel is exactly tall enough for the rows the container needs, so there is no empty area below the
  // slots and no scrolling. `ChestScreenController::addStaticScreenVars` sets exactly one of the
  // `$container_rows_*` flags; the sizes here follow the vanilla chest panels, where a three row chest is
  // 176x166 and a six row chest is 176x220, so each extra row adds 18 pixels.
  "desktop_panel": {
    "type": "panel",
    "variables": [
      {
        "requires": "$container_rows_1",
        "$container_root_size": [ 176, 130 ],
        "$container_top_half_size": [ "100%", 42 ]
      },
      {
        "requires": "$container_rows_2",
        "$container_root_size": [ 176, 148 ],
        "$container_top_half_size": [ "100%", 60 ]
      },
      {
        "requires": "$container_rows_3",
        "$container_root_size": [ 176, 166 ],
        "$container_top_half_size": [ "100%", 78 ]
      },
      {
        "requires": "$container_rows_4",
        "$container_root_size": [ 176, 184 ],
        "$container_top_half_size": [ "100%", 96 ]
      },
      {
        "requires": "$container_rows_5",
        "$container_root_size": [ 176, 202 ],
        "$container_top_half_size": [ "100%", 114 ]
      },
      {
        "requires": "$container_rows_6",
        "$container_root_size": [ 176, 220 ],
        "$container_top_half_size": [ "100%", 132 ]
      }
    ],
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@data_driven_container.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": "$container_root_size",
          "layer": 1,
          "controls": [
            { "common_panel@common.common_panel": {} },
            {
              "container_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "panel_top_half@data_driven_container.panel_top_half": {} },
                  { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                  { "hotbar_grid@common.hotbar_grid_template": {} },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} },
                  { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  },

  //// #endregion

  ////---------------------------------------------------------------------------
  //// #region pocket panel
  ////---------------------------------------------------------------------------

  "pocket_generic_label": {
    "type": "label",
    "layer": 2,
    "anchor_from": "center",
    "anchor_to": "center",
    "color": "$pocket_title_text_color"
  },

  "pocket_header_panel": {
    "type": "panel",
    "layer": 1,
    "size": [ "50%", "27px" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "header_background": {
          "type": "image",
          "texture": "textures/ui/header_bar"
        }
      },
      {
        "title_label@data_driven_container.pocket_generic_label": {
          "text": "$header_label",
          "localize": "$localize_title",
          "enable_profanity_filter": true
        }
      }
    ]
  },

  // The container title is authored by the pack, so unlike the inventory heading it is capped to the header and
  // truncated rather than allowed to overflow it.
  "pocket_container_header@data_driven_container.pocket_header_panel": {
    "controls": [
      {
        "header_background": {
          "type": "image",
          "texture": "textures/ui/header_bar"
        }
      },
      {
        "title_label@data_driven_container.pocket_generic_label": {
          "text": "$header_label",
          "localize": "$localize_title",
          "max_size": [ "100% - 14px", 10 ],
          "enable_profanity_filter": true
        }
      }
    ]
  },

  "pocket_header_area": {
    "type": "panel",
    "controls": [
      { "x@common.legacy_pocket_close_button": { "layer": 3 } },
      {
        "inventory_header@data_driven_container.pocket_header_panel": {
          "$header_label": "chestScreen.header.player",
          "$localize_title": true
        }
      },
      {
        "container_header@data_driven_container.pocket_container_header": {
          "layer": 2,
          "anchor_from": "top_middle",
          "$header_label": "$container_title"
        }
      }
    ]
  },

  "pocket_background_panel": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "texture": "textures/ui/background_panel",
    "layer": 2
  },

  "pocket_inventory_grid": {
    "type": "grid",
    "grid_rescaling_type": "horizontal",
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "size": [ "100%", "default" ],
    "maximum_grid_items": "$container_size",
    "collection_name": "$pane_collection",
    "grid_item_template": "common.pocket_ui_container_item",
    "$item_collection_name": "$pane_collection"
  },

  "pocket_inventory_panel": {
    "type": "panel",
    "size": [ "80%", "95%" ],
    "anchor_to": "center",
    "anchor_from": "center",
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "$allow_scrolling_even_when_content_fits": false,
          "layer": 1,
          "$scrolling_pane_size": [ "100%", "100%-2px" ],
          "$scrolling_content": "data_driven_container.pocket_inventory_grid",
          "$scroll_box_mouse_image_control": "common-classic.button_state_default",
          "$scroll_size": [ "8px", "100%" ]
        }
      }
    ]
  },

  "pocket_half_screen": {
    "type": "panel",
    "size": [ "50%", "100%-27px" ],
    "offset": [ 0, 27 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "inventory_panel@data_driven_container.pocket_inventory_panel": {} }
    ]
  },

  // The container half deliberately does not set `$container_size`: it falls through to the global that
  // ChestScreenController publishes from the live container, so its grid holds exactly slot_count cells.
  "pocket_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": { "layer": 3 } },
      { "header@data_driven_container.pocket_header_area": { "layer": 2 } },
      { "bg@data_driven_container.pocket_background_panel": { "layer": 0 } },
      {
        "inventory@data_driven_container.pocket_half_screen": {
          "$container_size": 36,
          "$pane_collection": "combined_hotbar_and_inventory_items"
        }
      },
      {
        "container@data_driven_container.pocket_half_screen": {
          "anchor_from": "top_middle",
          "$pane_collection": "container_items"
        }
      },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "$offset": [ 0, "85%" ]
        }
      },
      { "gamepad_cursor@common.gamepad_cursor_button": {} },
      { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
      { "hold_icon@common.inventory_take_progress_icon_button": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 12 } }
    ]
  },

  //// #endregion

  ////---------------------------------------------------------------------------
  //// #region screen
  ////---------------------------------------------------------------------------

  "screen@common.inventory_screen_common": {
    "$close_on_player_hurt|default": true,
    "$use_custom_pocket_toast|default": false,
    "close_on_player_hurt": "$close_on_player_hurt",
    "use_custom_pocket_toast": "$use_custom_pocket_toast",
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "data_driven_container.desktop_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_background_alpha": 0.4
      },
      {
        "requires": "$pocket_screen",
        "$use_custom_pocket_toast": true,
        "$screen_content": "data_driven_container.pocket_panel"
      }
    ]
  }

  //// #endregion
}
