{
  "namespace": "playfab_sign_in_conflict_help_qr",

  // -----------------------------------------------
  //
  //    screen
  //
  // -----------------------------------------------
  "playfab_sign_in_conflict_help_qr@common.base_screen": {
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ],
    "force_render_below": true,
    "$screen_content": "playfab_sign_in_conflict_help_qr.playfab_sign_in_conflict_help_qr_screen_content",
    "$screen_background_control": "playfab_sign_in_conflict_help_qr.background"
  },

  "background@common.screen_background": {
    "alpha": 0.65,
    "layer": 1
  },

  "playfab_sign_in_conflict_help_qr_screen_content": {
    "type": "panel",
    "controls": [
      {
        "dialog@playfab_sign_in_conflict_help_qr.playfab_sign_in_conflict_help_qr_popup": {
          "layer": 1
        }
      }
    ]
  },

  // -----------------------------------------------
  //
  //    dialog
  //
  // -----------------------------------------------
  "playfab_sign_in_conflict_help_qr_popup@common_dialogs.main_panel_one_button": {
    "size": [ 380, 210 ],
    "$text_name": "xbox.signin.incorrectAccount.visitHelpPage",
    "$child_control": "playfab_sign_in_conflict_help_qr.main_panel_qr",
    "$button_panel": "playfab_sign_in_conflict_help_qr.close_button"
  },

  "close_button@common_buttons.light_text_button": {
    "size": [ "100% - 14px", 30 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "$pressed_button_name": "button.menu_exit",
    "$button_text": "gui.close",
    "$button_text_binding_type": "none"
  },

  "main_panel_qr": {
    "type": "stack_panel",
    "size": [ "100% - 4px", "100% - 4px" ],
    "orientation": "vertical",
    "controls": [
      {
        "qr_panel": {
          "type": "panel",
          "size": [ "100%", "fill" ],
          "controls": [
            {
              "qr_border": {
                "type": "image",
                "texture": "textures/ui/White",
                "keep_ratio": false,
                "anchor_to": "center",
                "anchor_from": "center",
                "size": [ "100%y", "90%" ],
                "layer": 1
              }
            },
            {
              "qr_code": {
                "type": "custom",
                "renderer": "qr_code_renderer",
                "size": [ "100%y", "90% - 8px" ],
                "anchor_to": "center",
                "anchor_from": "center",
                "layer": 2,
                "bindings": [
                  {
                    "binding_name": "#qr_code_content",
                    "binding_condition": "once"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "url_label_top_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "url_label": {
          "type": "label",
          "size": [ "100%", 10 ],
          "text": "xbox.signin.incorrectAccount.helplink",
          "text_alignment": "center",
          "color": "$body_text_color",
          "font_type": "smooth",
          "layer": 2
        }
      },
      {
        "url_label_bottom_padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      }
    ]
  }
}
