              "component_groups": [
                "minecraft:mode_switcher",
                "minecraft:ranged_equipment",
                "minecraft:frostbite_baby",
                "minecraft:frostbite_baby_jockey"
              ]
            }
          },
          {
            "trigger": "minecraft:switch_to_ranged"
          }
        ]
      },
      // Modes
      "minecraft:enable_mode_switcher": {
        "set_property": {
          "minecraft:is_mode_switcher_enabled": true
        },
        "add": {
          "component_groups": [
            "minecraft:mode_switcher"
          ]
        }
      },
      "minecraft:disable_mode_switcher": {
        "set_property": {
          "minecraft:is_mode_switcher_enabled": false
        },
        "trigger": "minecraft:switch_to_melee",
        "remove": {
          "component_groups": [
            "minecraft:mode_switcher"
          ]
        }
      },
      "minecraft:switch_to_melee": {
        "sequence": [
          {
            "set_property": {
              "minecraft:is_ranged_mode": false
            },
            "add": {
              "component_groups": [
                "minecraft:melee_mode"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:ranged_mode",
                "minecraft:ranged_mode_easy",
                "minecraft:ranged_mode_normal",
                "minecraft:ranged_mode_hard"
              ]
            }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "easy"
            },
            "add": { "component_groups": [ "minecraft:melee_mode_easy" ] }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "normal"
            },
            "add": { "component_groups": [ "minecraft:melee_mode_normal" ] }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "hard"
            },
            "add": { "component_groups": [ "minecraft:melee_mode_hard" ] }
          }
        ]
      },
      "minecraft:switch_to_ranged": {
        "filters": {
          "test": "has_equipment",
          "subject": "self",
          "domain": "hand",
          "value": "minecraft:ice_ball"
        },
        "sequence": [
          {
            "set_property": {
              "minecraft:is_ranged_mode": true
            },
            "add": {
              "component_groups": [
                "minecraft:ranged_mode"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:melee_mode",
                "minecraft:melee_mode_easy",
                "minecraft:melee_mode_normal",
                "minecraft:melee_mode_hard"
              ]
            }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "easy"
            },
            "add": { "component_groups": [ "minecraft:ranged_mode_easy" ] }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "normal"
            },
            "add": { "component_groups": [ "minecraft:ranged_mode_normal" ] }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "value": "hard"
            },
            "add": { "component_groups": [ "minecraft:ranged_mode_hard" ] }
          }
        ]
      },
      // Transformations
      "minecraft:start_transforming_into_zombie": {
        "add": {
          "component_groups": [
            "minecraft:start_zombie_transformation"
          ]
        },
        "remove": {
          "component_groups": [
            "minecraft:look_to_start_transformations"
          ]
        }
      },
      "minecraft:stop_transforming": {
        "remove": {
          "component_groups": [
            "minecraft:start_zombie_transformation"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:look_to_start_transformations"
          ]
        }
      },
      "minecraft:convert_to_zombie": {
        "sequence": [
          {
            "filters": {
              "test": "has_component",
              "operator": "!=",
              "value": "minecraft:is_baby"
            },
            "add": {
              "component_groups": [
                "minecraft:convert_to_zombie"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:start_zombie_transformation"
              ]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "value": "minecraft:is_baby"
            },
            "add": {
              "component_groups": [
                "minecraft:convert_to_baby_zombie"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:start_zombie_transformation"
              ]
            }
          }
        ]
      }
    }
  }
}
