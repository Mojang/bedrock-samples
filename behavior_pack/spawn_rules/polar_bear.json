{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "minecraft:polar_bear",
      "population_control": "animal"
    },
    "conditions": [
      // 1 spawn weight
      // Frozen biomes, except Frozen Oceans and Ice Caves
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:weight": {
          "default": 1
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2,
          "event": "minecraft:entity_born",
          "event_skip_count": 1
        },
        "minecraft:biome_filter": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          },
          {
            "test": "has_biome_tag",
            "operator": "!=",
            "value": "ocean"
          },
          {
            "test": "has_biome_tag",
            "operator": "!=",
            "value": "ice_caves"
          }
        ]
      },
      // 5 spawn weight
      // Frozen Oceans, only on Ice
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": "minecraft:ice",
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:weight": {
          "default": 5
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2,
          "event": "minecraft:entity_born",
          "event_skip_count": 1
        },
        "minecraft:biome_filter": [
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "frozen"
          },
          {
            "test": "has_biome_tag",
            "operator": "==",
            "value": "ocean"
          }
        ]
      }
    ]
  }
}
