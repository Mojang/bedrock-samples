{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "minecraft:frostbite",
      "population_control": "monster"
    },
    "conditions": [
      // 50 spawn weight
      // Ice caves
      {
        "minecraft:biome_filter": {
          "all_of": [
            {
              "test": "has_biome_tag",
              "value": "ice_caves"
            }
          ]
        },
        "minecraft:weight": {
          "default": 50
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_underground": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        }
      },
      // 45 spawn weight
      // Frozen peaks, ice spikes, frozen deep ocean, ocean and river
      {
        "minecraft:biome_filter": {
          "all_of": [
            { // Exclude previous conditions
              "test": "has_biome_tag",
              "operator": "not",
              "value": "ice_caves"
            },
            { // Allow biomes
              "any_of": [
                { // Frozen peaks
                  "test": "has_biome_tag",
                  "value": "frozen_peaks"
                },
                { // Ice (plains) spikes
                  "all_of": [
                    {
                      "test": "has_biome_tag",
                      "value": "ice_plains"
                    },
                    {
                      "test": "has_biome_tag",
                      "value": "mutated"
                    }
                  ]
                },
                { // Frozen deep ocean, ocean and river
                  "all_of": [
                    {
                      "test": "has_biome_tag",
                      "value": "frozen"
                    },
                    {
                      "any_of": [
                        {
                          "test": "has_biome_tag",
                          "value": "ocean"
                        },
                        {
                          "test": "has_biome_tag",
                          "value": "river"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "minecraft:weight": {
          "default": 45
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        }
      },
      // 25 spawn weight
      // Snowy plains, jagged peaks, snowy slopes
      {
        "minecraft:biome_filter": {
          "all_of": [
            { // Exclude previous conditions
              "all_of": [
                { // Ice caves
                  "test": "has_biome_tag",
                  "operator": "not",
                  "value": "ice_caves"
                },
                { // Frozen peaks
                  "test": "has_biome_tag",
                  "operator": "not",
                  "value": "frozen_peaks"
                },
                { // Frozen deep ocean, ocean and river
                  "all_of": [
                    {
                      "test": "has_biome_tag",
                      "value": "frozen"
                    },
                    {
                      "test": "has_biome_tag",
                      "operator": "not",
                      "value": "ocean"
                    },
                    {
                      "test": "has_biome_tag",
                      "operator": "not",
                      "value": "river"
                    }
                  ]
                }
              ]
            },
            { // Allow biomes
              "any_of": [
                { // Snowy plains
                  "all_of": [
                    {
                      "test": "has_biome_tag",
                      "value": "ice_plains"
                    },
                    {
                      "test": "has_biome_tag",
                      "operator": "not",
                      "value": "mutated"
                    }
                  ]
                },
                { // Jagged peaks
                  "test": "has_biome_tag",
                  "value": "jagged_peaks"
                },
                { // Snowy slopes
                  "test": "has_biome_tag",
                  "value": "snowy_slopes"
                }
              ]
            }
          ]
        },
        "minecraft:weight": {
          "default": 25
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        }
      }
    ]
  }
}
