{
    "title": "SubChunkPosOffset",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/SubChunkPosOffset.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Subchunk Offset X": {
            "description": "Relative X offset from center position.",
            "type": "integer",
            "x-underlying-type": "int8",
            "x-ordinal-index": 0,
            "minimum": -128.0,
            "maximum": 127.0
        },
        "Subchunk Offset Y": {
            "description": "Relative Y offset from center position.",
            "type": "integer",
            "x-underlying-type": "int8",
            "x-ordinal-index": 1,
            "minimum": -128.0,
            "maximum": 127.0
        },
        "Subchunk Offset Z": {
            "description": "Relative Z offset from center position.",
            "type": "integer",
            "x-underlying-type": "int8",
            "x-ordinal-index": 2,
            "minimum": -128.0,
            "maximum": 127.0
        }
    },
    "required": [
        "Subchunk Offset X",
        "Subchunk Offset Y",
        "Subchunk Offset Z"
    ]
}