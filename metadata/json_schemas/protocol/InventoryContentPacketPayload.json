{
    "title": "InventoryContentPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/InventoryContentPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Container Id": {
            "description": "The container ID",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 0,
            "minimum": 0.0
        },
        "Full Container Name": {
            "description": "Used to reference a specific container within a given screen container context",
            "$ref": "./FullContainerName.json",
            "x-ordinal-index": 2
        },
        "Slots": {
            "description": "The item stacks for each inventory slot",
            "type": "array",
            "items": {
                "$ref": "./NetworkItemStackDescriptor.json"
            },
            "x-ordinal-index": 1
        },
        "Storage Item": {
            "description": "Optional storage item containing the contents to set. Only the item type is relevant, not any stack information.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Container Id",
        "Full Container Name",
        "Slots",
        "Storage Item"
    ]
}