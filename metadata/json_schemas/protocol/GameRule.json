{
    "title": "GameRule",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/GameRule.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Rule Can Be Modified": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 1
        },
        "Rule Name": {
            "type": "string",
            "x-ordinal-index": 0
        },
        "Rule Value": {
            "oneOf": [
                {
                    "type": "null",
                    "x-ordinal-index": 0
                },
                {
                    "type": "boolean",
                    "x-underlying-type": "boolean",
                    "x-ordinal-index": 1
                },
                {
                    "type": "integer",
                    "x-underlying-type": "int32",
                    "x-ordinal-index": 2
                },
                {
                    "type": "number",
                    "x-underlying-type": "float",
                    "x-ordinal-index": 3
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 2
        }
    },
    "required": [
        "Rule Can Be Modified",
        "Rule Name",
        "Rule Value"
    ]
}