{
    "title": "CommandOriginData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CommandOriginData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "PlayerId": {
            "description": "The player Id.",
            "type": "integer",
            "default": 0,
            "x-underlying-type": "int64",
            "x-ordinal-index": 3
        },
        "RequestId": {
            "description": "The request Id.",
            "type": "string",
            "default": "",
            "x-ordinal-index": 2,
            "maxLength": 39
        },
        "Type": {
            "description": "The command origin type.",
            "type": "string",
            "enum": [
                "Player",
                "DevConsole",
                "Test",
                "AutomationPlayer"
            ],
            "x-underlying-type": "uint8",
            "x-ordinal-index": 0
        },
        "UUID": {
            "description": "The unique UUID that represents an instantiation of a command. Each time a command is run it should be given a UUID to represent that instance.",
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "Type",
        "UUID"
    ]
}