{
    "title": "ItemStackRequestNetworkItemInstanceDescriptor",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ItemStackRequestNetworkItemInstanceDescriptor.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Block Runtime Id": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2,
            "minimum": 0.0
        },
        "Item Descriptor": {
            "oneOf": [
                {
                    "$ref": "./EmptyItemDescriptor.json"
                },
                {
                    "$ref": "./ItemNameDescriptor.json"
                },
                {
                    "$ref": "./MolangItemDescriptor.json"
                },
                {
                    "$ref": "./ItemTagDescriptor.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 0
        },
        "Stack size": {
            "type": "integer",
            "x-underlying-type": "uint16",
            "x-ordinal-index": 1,
            "minimum": 1.0,
            "maximum": 64.0
        },
        "User Data Buffer": {
            "description": "The @ItemInstanceUserData.html#ItemInstanceUserData@ binary blob encoded as a String, so it's unsigned varint length prefixed. Get all your nbt+property bytes, calculate the length, write that length, THEN write the data.",
            "type": "string",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Block Runtime Id",
        "Item Descriptor",
        "Stack size",
        "User Data Buffer"
    ]
}