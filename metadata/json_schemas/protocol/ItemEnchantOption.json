{
    "title": "ItemEnchantOption",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ItemEnchantOption.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "description": "A helper to group a potential enchantment by its name, cost, and resulting enchanted item -- effectively a mini-recipe.",
    "type": "object",
    "properties": {
        "Cost": {
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 0,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Enchant Name": {
            "type": "string",
            "x-ordinal-index": 2,
            "minLength": 1,
            "maxLength": 256
        },
        "Enchant Net Id": {
            "$ref": "./RecipeNetId.json",
            "x-ordinal-index": 3
        },
        "Enchants": {
            "$ref": "./ItemEnchants.json",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "Cost",
        "Enchant Name",
        "Enchant Net Id",
        "Enchants"
    ]
}