{
    "title": "CameraSplineRotationKeyFrame",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CameraSplineRotationKeyFrame.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "easing": {
            "description": "Optional easing function used to interpolate towards this rotation key frame. Defaults to \"linear\" if omitted.",
            "$ref": "./easing_function.json",
            "x-underlying-type": "int32",
            "x-ordinal-index": 2
        },
        "rotation": {
            "description": "Rotation [x, y, z] value.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 0
        },
        "time": {
            "description": "Time (in seconds) at which this rotation should be applied.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1,
            "minimum": 0.0
        }
    },
    "required": [
        "rotation",
        "time"
    ]
}