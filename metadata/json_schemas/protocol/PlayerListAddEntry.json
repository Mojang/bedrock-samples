{
    "title": "PlayerListAddEntry",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/PlayerListAddEntry.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Action": {
            "description": "Discriminator selecting the Add form of the entry.",
            "type": "string",
            "enum": [
                "Add"
            ],
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 0
        },
        "Actor Unique ID": {
            "description": "Unique actor ID of the player.",
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 2
        },
        "Build Platform": {
            "description": "The device/build platform the player is on.",
            "$ref": "./BuildPlatform.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 6
        },
        "Is Host": {
            "description": "Whether the player is the host of the session.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 9
        },
        "Is SubClient": {
            "description": "Whether the player is a split-screen sub-client.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 10
        },
        "Is Teacher": {
            "description": "Whether the player is an Education Edition teacher.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 8
        },
        "Platform Online ID": {
            "description": "Platform-specific online ID of the player.",
            "type": "string",
            "x-ordinal-index": 5
        },
        "Player Color": {
            "description": "The player's name-tag/UI color.",
            "$ref": "./Color.json",
            "x-ordinal-index": 11
        },
        "Player Name": {
            "description": "Display name of the player.",
            "type": "string",
            "x-ordinal-index": 3
        },
        "Serialized Skin": {
            "description": "The player's serialized skin, cape and geometry data.",
            "$ref": "./SerializedSkin.json",
            "x-ordinal-index": 7
        },
        "UUID": {
            "description": "UUID of the player being added.",
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 1
        },
        "XBL XUID": {
            "description": "Xbox Live user ID of the player, when available.",
            "type": "string",
            "x-ordinal-index": 4
        }
    },
    "required": [
        "Action",
        "Actor Unique ID",
        "Build Platform",
        "Is Host",
        "Is SubClient",
        "Is Teacher",
        "Platform Online ID",
        "Player Color",
        "Player Name",
        "Serialized Skin",
        "UUID",
        "XBL XUID"
    ]
}