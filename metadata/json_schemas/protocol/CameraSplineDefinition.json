{
    "title": "CameraSplineDefinition",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CameraSplineDefinition.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "control_points": {
            "description": "Array of control point positions, each as [x, y, z] in world space.",
            "type": "array",
            "items": {
                "$ref": "./CameraSplineControlPoint.json"
            },
            "x-ordinal-index": 3
        },
        "name": {
            "description": "The identifier for this spline, in \"namespace:name\" format.",
            "type": "string",
            "x-ordinal-index": 0,
            "pattern": "^\\w+:\\w+$"
        },
        "progress_key_frames": {
            "description": "Key frames where each entry defines a progress alpha [0-1] and a time (in seconds) when the spline should reach that progress.",
            "type": "array",
            "items": {
                "$ref": "./CameraSplineProgressKeyFrame.json"
            },
            "x-ordinal-index": 4
        },
        "rotation_key_frames": {
            "description": "Array of rotation key frames, each with a rotation value and the time (in seconds) when it should be applied.",
            "type": "array",
            "items": {
                "$ref": "./CameraSplineRotationKeyFrame.json"
            },
            "x-ordinal-index": 5
        },
        "spline_type": {
            "description": "The spline interpolation type: \"catmullrom\" or \"linear\". Defaults to \"catmullrom\".",
            "type": "string",
            "default": "catmullrom",
            "x-ordinal-index": 2,
            "pattern": "^(?:catmullrom|linear)$"
        },
        "total_time": {
            "description": "The total time, in seconds, to play back the spline.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1,
            "minimum": 0.0
        }
    },
    "required": [
        "control_points",
        "name",
        "progress_key_frames",
        "rotation_key_frames",
        "total_time"
    ]
}