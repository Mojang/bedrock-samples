{
    "title": "DebugMarkerData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/DebugMarkerData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Color": {
            "description": "Color of the debug cube to show",
            "$ref": "./Color.json",
            "x-ordinal-index": 2
        },
        "Position": {
            "description": "Position for where the debug cube should show up",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 1
        },
        "Text": {
            "description": "String for what text to show at the location",
            "type": "string",
            "x-ordinal-index": 0,
            "maxLength": 4096
        },
        "duration": {
            "description": "Duration (milliseconds) of the debug cube to show",
            "type": "integer",
            "x-underlying-type": "uint64",
            "x-ordinal-index": 3,
            "minimum": 0.0
        }
    },
    "required": [
        "Color",
        "Position",
        "Text",
        "duration"
    ]
}