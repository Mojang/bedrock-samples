{
    "title": "AddPlayerPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/AddPlayerPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Abilities Data": {
            "description": "The player's permissions and ability layers.",
            "$ref": "./SerializedAbilitiesData.json",
            "x-ordinal-index": 12
        },
        "Actor Links": {
            "description": "Actor links describing what the player is riding or linked to.",
            "type": "array",
            "items": {
                "$ref": "./ActorLink.json"
            },
            "x-ordinal-index": 13
        },
        "Build Platform": {
            "description": "The device/build platform the player is on.",
            "$ref": "./BuildPlatform.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 15
        },
        "Carried Item": {
            "description": "The item currently held by the player.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 8
        },
        "Device Id": {
            "description": "A unique device id obtained from the connection request.",
            "type": "string",
            "x-ordinal-index": 14
        },
        "Entity Data": {
            "description": "Synched actor data (data items) for the player entity.",
            "$ref": "./SynchedActorDataList.json",
            "x-ordinal-index": 10
        },
        "Platform Chat Id": {
            "description": "Platform-specific online ID used for platform chat.",
            "type": "string",
            "x-ordinal-index": 3
        },
        "Player Game Type": {
            "description": "The player's game mode.",
            "$ref": "./GameType.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 9
        },
        "Player Name": {
            "description": "Display name of the player.",
            "type": "string",
            "x-ordinal-index": 1
        },
        "Position": {
            "description": "Spawn position of the player, with the actor height offset already applied.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 4
        },
        "Rotation": {
            "description": "Body rotation (pitch, yaw) in degrees.",
            "$ref": "./Vec2.json",
            "x-ordinal-index": 6
        },
        "Synched Properties": {
            "description": "Synched entity property values for the player.",
            "$ref": "./PropertySyncData.json",
            "x-ordinal-index": 11
        },
        "Target Runtime ID": {
            "description": "Runtime ID of the spawned player actor.",
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 2
        },
        "UUID": {
            "description": "The player's unique account UUID, used to match the entry to a player list entry and skin.",
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 0
        },
        "Velocity": {
            "description": "Initial velocity of the player.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 5
        },
        "Y-Head Rotation": {
            "description": "Head yaw rotation in degrees.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 7
        }
    },
    "required": [
        "Abilities Data",
        "Actor Links",
        "Build Platform",
        "Carried Item",
        "Device Id",
        "Entity Data",
        "Platform Chat Id",
        "Player Game Type",
        "Player Name",
        "Position",
        "Rotation",
        "Synched Properties",
        "Target Runtime ID",
        "UUID",
        "Velocity",
        "Y-Head Rotation"
    ]
}