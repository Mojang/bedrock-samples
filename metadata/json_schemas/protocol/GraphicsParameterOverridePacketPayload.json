{
    "title": "GraphicsParameterOverridePacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/GraphicsParameterOverridePacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Biome Identifier": {
            "description": "Determines which biome the override parameter is applied to",
            "type": "string",
            "x-ordinal-index": 3,
            "maxLength": 255
        },
        "Float Value": {
            "description": "If set, contains a single float graphics parameter to be overriden",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1
        },
        "Identifier for Parameter": {
            "description": "Identifier for the parameter that is having its value changed",
            "$ref": "./GraphicsOverrideParameterType.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 5
        },
        "Parameter Keyframe Values": {
            "description": "Time of Day key to Graphics Parameter value, Depending on the parameters, either all three components are used as a color or just the x component is used as a float, int, or bool",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "number",
                        "x-underlying-type": "float"
                    },
                    "value": {
                        "$ref": "./Vec3.json"
                    }
                }
            },
            "x-ordinal-index": 0,
            "maxProperties": 255
        },
        "Player Identifier": {
            "description": "Determines which player the override parameter is applied to",
            "type": "string",
            "x-ordinal-index": 4,
            "maxLength": 255
        },
        "Reset Parameter": {
            "description": "If true, the specified parameter will be reset. If false, the parameter will be set using the data fields.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 6
        },
        "Vec3 Value": {
            "description": "If set, contains a single Vec3 graphics parameter to be overriden",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 2
        }
    },
    "required": [
        "Biome Identifier",
        "Float Value",
        "Identifier for Parameter",
        "Parameter Keyframe Values",
        "Reset Parameter",
        "Vec3 Value"
    ]
}