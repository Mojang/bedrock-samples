{
    "title": "VoxelShapesPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/VoxelShapesPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Custom Shape Count": {
            "description": "The number of custom voxel shapes",
