            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "key": {
                        "$ref": "./hashed_string.json"
                    },
                    "value": {
                        "$ref": "./VoxelShapes__RegistryHandle.json"
                    }
                }
            },
            "x-ordinal-index": 1
        },
        "Shapes": {
            "description": "Voxel shape structural data",
            "type": "array",
            "items": {
                "$ref": "./VoxelShapes__SerializableVoxelShape.json"
            },
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Custom Shape Count",
        "Name Map",
        "Shapes"
