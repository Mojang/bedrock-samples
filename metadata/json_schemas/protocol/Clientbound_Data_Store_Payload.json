{
    "title": "Clientbound Data Store Payload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/Clientbound_Data_Store_Payload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Updates": {
            "description": "List of changes, updates, or removals that have occurred to the data store",
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "$ref": "./Data_Store_Update.json"
                    },
                    {
                        "$ref": "./Data_Store_Change.json"
                    },
                    {
                        "$ref": "./Data_Store_Removal.json"
                    }
                ],
                "x-control-value-type": "uint32"
            },
            "x-ordinal-index": 0,
            "maxItems": 500
        }
    },
    "required": [
        "Updates"
    ]
}