{
    "title": "BossEventPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/BossEventPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Color": {
            "description": "color for the boss bar, listed in an enumeration",
            "$ref": "./BossBarColor.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 6
        },
        "Event Type": {
            "description": "type of boss event",
            "$ref": "./BossEventUpdateType.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 2
        },
        "FilteredName": {
            "description": "Filtered name of the boss to add",
            "type": "string",
            "x-ordinal-index": 4,
            "maxLength": 256
        },
        "Health Percent": {
            "description": "Health value of the boss",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 5
        },
        "Name": {
            "description": "Name of the boss to add",
            "type": "string",
            "x-ordinal-index": 3,
            "maxLength": 256
        },
        "Overlay": {
            "description": "overlay for the boss bar, listed in an enumeration",
            "$ref": "./BossBarOverlay.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 7
        },
        "Player ID": {
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 1
        },
        "Target Actor ID": {
            "description": "actor id for the boss",
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Color",
        "Event Type",
        "FilteredName",
        "Health Percent",
        "Name",
        "Overlay",
        "Player ID",
        "Target Actor ID"
    ]
}