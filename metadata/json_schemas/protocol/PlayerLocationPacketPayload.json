        },
        "Target Actor ID": {
            "description": "Unique ID of the player whose location is being updated or hidden.",
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Location",
        "Target Actor ID"
    ]
}