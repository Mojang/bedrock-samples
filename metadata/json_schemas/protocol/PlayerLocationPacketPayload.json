{
    "title": "PlayerLocationPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/PlayerLocationPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Location": {
            "description": "Either updated coordinates for the tracked actor or a request to hide them.",
