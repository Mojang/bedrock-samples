{
    "title": "StartGamePacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/StartGamePacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Block Properties": {
            "type": "array",
            "items": {
                "$ref": "./ServerBlockProperty.json"
            },
            "x-ordinal-index": 13
        },
        "BlockNetworkIds Are Hashes": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 21
        },
        "Enable Item Stack Net Manager": {
            "description": "Whether the new item stack net manager is enabled for server authoritative inventory.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 15
        },
        "Enchantment Seed": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 12
        },
        "Entity ID": {
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 0
        },
        "Game Type": {
            "type": "string",
            "enum": [
                "Undefined",
                "Survival",
                "Creative",
                "Adventure",
                "Default",
                "Spectator",
                "WorldDefault"
            ],
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 2
        },
        "Is Trial": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 9
        },
        "Level Current Time": {
            "type": "integer",
            "x-underlying-type": "uint64",
            "x-ordinal-index": 11,
            "minimum": 0.0
        },
        "Level ID": {
            "type": "string",
            "x-ordinal-index": 6
        },
        "Level Name": {
            "type": "string",
            "x-ordinal-index": 7
        },
        "Movement Settings": {
            "$ref": "./SyncedPlayerMovementSettings.json",
            "x-ordinal-index": 10
        },
        "Multiplayer Correlation Id": {
            "description": "A UUID to identify this multiplayer session.",
            "type": "string",
            "x-ordinal-index": 14
        },
        "NetworkPermissions": {
            "$ref": "./NetworkPermissions.json",
            "x-ordinal-index": 22
        },
        "Player Property Data": {
            "description": "like SyncActorPropertyPacket, specifically for minecraft:player properties",
            "x-ordinal-index": 17
        },
        "Position": {
            "$ref": "./Vec3.json",
            "x-ordinal-index": 3
        },
        "Rotation": {
            "$ref": "./Vec2.json",
            "x-ordinal-index": 4
        },
        "Runtime ID": {
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 1
        },
        "Server Block Type Registry Checksum": {
            "description": "Checksum for detecting mismatches in block types between server and client.",
            "type": "integer",
            "x-underlying-type": "uint64",
            "x-ordinal-index": 18,
            "minimum": 0.0
        },
        "Server Configuration Join Info": {
            "$ref": "./server_config.json",
            "x-ordinal-index": 23
        },
        "Server Enabled ClientSide Generation": {
            "description": "BiomeComponentFactory needs to know about this toggle before we start parsing BiomeComponents",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 20
        },
        "Server Telemetry Data": {
            "$ref": "./ServerTelemetryData.json",
            "x-ordinal-index": 24
        },
        "Server Version": {
            "description": "For telemetry purposes - sending your own string with your own server name and version here would be useful for Mojang's telemetry.",
            "type": "string",
            "x-ordinal-index": 16
        },
        "Settings": {
            "$ref": "./LevelSettings.json",
            "x-ordinal-index": 5
        },
        "Template Content Identity": {
            "type": "string",
            "x-ordinal-index": 8
        },
        "World Template ID": {
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 19
        }
    },
    "required": [
        "Block Properties",
        "BlockNetworkIds Are Hashes",
        "Enable Item Stack Net Manager",
        "Enchantment Seed",
        "Entity ID",
        "Game Type",
        "Is Trial",
        "Level Current Time",
        "Level ID",
        "Level Name",
        "Movement Settings",
        "Multiplayer Correlation Id",
        "NetworkPermissions",
        "Player Property Data",
        "Position",
        "Rotation",
        "Runtime ID",
        "Server Block Type Registry Checksum",
        "Server Enabled ClientSide Generation",
        "Server Telemetry Data",
        "Server Version",
        "Settings",
        "Template Content Identity",
        "World Template ID"
    ]
}