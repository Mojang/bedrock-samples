{
    "title": "CameraSplineProgressKeyFrame",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CameraSplineProgressKeyFrame.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "easing": {
            "description": "Optional easing function used to interpolate towards this progress key frame. Defaults to \"linear\" if omitted.",
            "$ref": "./easing_function.json",
            "x-underlying-type": "int32",
            "x-ordinal-index": 2
        },
        "progress": {
            "description": "Normalized progress of this frame along the spline, from 0.0 (start) to 1.0 (end).",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 0,
            "minimum": 0.0,
            "maximum": 1.0
        },
        "time": {
            "description": "Time (in seconds) at which this progress should be applied.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1,
            "minimum": 0.0
        }
    },
    "required": [
        "progress",
        "time"
    ]
}