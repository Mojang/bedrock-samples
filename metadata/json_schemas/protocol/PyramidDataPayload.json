{
    "title": "PyramidDataPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/PyramidDataPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Depth": {
            "description": "Depth along the Z axis (defaults to width if unset).",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1
        },
        "Height": {
            "description": "Height of the debug pyramid.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 2
        },
        "Width": {
            "description": "Width along the X axis of the debug pyramid base.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Height",
        "Width"
    ]
}