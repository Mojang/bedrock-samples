{
    "title": "InventorySlotPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/InventorySlotPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Container Id": {
            "description": "The container ID",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 0,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Full Container Name": {
            "description": "Optional reference to a specific container within a given screen container context",
            "$ref": "./FullContainerName.json",
            "x-ordinal-index": 2
        },
        "Item": {
            "description": "The item stack for this inventory slot",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 4
        },
        "Slot": {
            "description": "The slot index in the container",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 1,
            "minimum": 0.0
        },
        "Storage Item": {
            "description": "Optional storage item to set the 'Item' into. (e.g. bundle)",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Container Id",
        "Item",
        "Slot"
    ]
}