{
    "title": "TextPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/TextPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Body": {
            "description": "Message content (variant based on message type)",
            "oneOf": [
                {
                    "$ref": "./MessageOnly.json"
                },
                {
                    "$ref": "./AuthorAndMessage.json"
                },
                {
                    "$ref": "./MessageAndParams.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 1
        },
        "Filtered Message": {
            "description": "Profanity-filtered version of the message (if applicable)",
            "type": "string",
            "x-ordinal-index": 4,
            "maxLength": 65536
        },
        "Localize?": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 0
        },
        "Platform Id": {
            "description": "Platform-specific user identifier",
            "type": "string",
            "default": "",
            "x-ordinal-index": 3,
            "maxLength": 256
        },
        "Sender's XUID": {
            "description": "Xbox User ID of the message sender",
            "type": "string",
            "default": "",
            "x-ordinal-index": 2,
            "maxLength": 64
        }
    },
    "required": [
        "Body",
        "Localize?"
    ]
}