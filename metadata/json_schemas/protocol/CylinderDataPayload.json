{
    "title": "CylinderDataPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CylinderDataPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Height": {
            "description": "Height of the debug cylinder.",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 2
        },
        "Num Segments": {
            "description": "Number of segments used for the debug cylinder.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 3,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Radius X": {
            "description": "Radius along the X axis of the debug cylinder.",
            "$ref": "./Vec2.json",
            "x-ordinal-index": 0
        },
        "Radius Z": {
            "description": "Radius along the Z axis of the debug cylinder.",
            "$ref": "./Vec2.json",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "Height",
        "Num Segments",
        "Radius X",
        "Radius Z"
    ]
}