{
    "title": "ShapelessRecipePayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ShapelessRecipePayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Ingredients": {
            "description": "The unordered ingredients required by the recipe.",
            "type": "array",
            "items": {
                "$ref": "./RecipeIngredient.json"
            },
            "x-ordinal-index": 1,
            "maxItems": 128
        },
        "Net Id": {
            "description": "Network id assigned to this recipe.",
            "$ref": "./RecipeNetId.json",
            "x-ordinal-index": 7
        },
        "Priority": {
            "description": "Recipe priority used to resolve conflicts between matching recipes.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 5
        },
        "Recipe Id": {
            "description": "Unique string identifier of the recipe.",
            "type": "string",
            "x-ordinal-index": 0
        },
        "Results": {
            "description": "The item(s) produced by the recipe.",
            "type": "array",
            "items": {
                "$ref": "./NetworkItemInstanceDescriptorData.json"
            },
            "x-ordinal-index": 2
        },
        "Tag": {
            "description": "Crafting block tag this recipe is associated with (e.g. crafting_table).",
            "type": "string",
            "x-ordinal-index": 4
        },
        "UUID": {
            "description": "Stable unique id of the recipe.",
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 3
        },
        "Unlocking Requirement": {
            "description": "Optional requirement that must be satisfied to unlock the recipe.",
            "$ref": "./RecipeUnlockingRequirement.json",
            "x-ordinal-index": 6
        }
    },
    "required": [
        "Ingredients",
        "Net Id",
        "Priority",
        "Recipe Id",
        "Results",
        "Tag",
        "UUID"
    ]
}