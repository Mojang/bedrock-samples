{
    "title": "CommandBlockUpdatePacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CommandBlockUpdatePacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Command": {
            "type": "string",
            "x-ordinal-index": 1
        },
        "Execute On First Tick": {
            "description": "If a delay is set on a repeating command block, should the command execute on first tick, or on first delay?",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 7
        },
        "FilteredName": {
            "type": "string",
            "x-ordinal-index": 4
        },
        "Last Output": {
            "type": "string",
            "x-ordinal-index": 2
        },
        "Name": {
            "type": "string",
            "x-ordinal-index": 3
        },
        "Target": {
            "description": "The command block target. The variant index encodes the legacy 'Is Block?' bool: 0 = entity (e.g. minecart command block), 1 = block.",
            "oneOf": [
                {
                    "$ref": "./EntityCommandTarget.json"
                },
                {
                    "$ref": "./BlockCommandData.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 0
        },
        "Tick Delay": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-ordinal-index": 6
        },
        "Track Output": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 5
        }
    },
    "required": [
        "Command",
        "Execute On First Tick",
        "FilteredName",
        "Last Output",
        "Name",
        "Target",
        "Tick Delay",
        "Track Output"
    ]
}