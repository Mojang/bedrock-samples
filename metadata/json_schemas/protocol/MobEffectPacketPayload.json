{
    "title": "MobEffectPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/MobEffectPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Ambient": {
            "description": "If the effect is considered ambient (like the ones applied by Beacons or Conduits)",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 7
        },
        "Effect Amplifier": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 3
        },
        "Effect Duration Ticks": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 5
        },
        "Effect ID": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2
        },
        "Event ID": {
            "$ref": "./MobEffectPacketPayload__Event.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 1
        },
        "Show Particles": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 4
        },
        "Target Runtime ID": {
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 0
        },
        "Tick": {
            "description": "If this packet is referring to the player or a client predicted vehicle they are in control of, this should be the most recently processed PlayerInputTick from their PlayerAuthInputPacket. Otherwise zero.",
            "$ref": "./PlayerInputTick.json",
            "x-ordinal-index": 6
        }
    },
    "required": [
        "Ambient",
        "Effect Amplifier",
        "Effect Duration Ticks",
        "Effect ID",
        "Event ID",
        "Show Particles",
        "Target Runtime ID",
        "Tick"
    ]
}