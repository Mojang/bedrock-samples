{
    "title": "NetworkItemInstanceDescriptorData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/NetworkItemInstanceDescriptorData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Aux value": {
            "description": "Item auxiliary/metadata value. Ignored for block items where aux is always 0.",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2,
            "minimum": 0.0,
            "maximum": 32767.0
        },
        "Block Runtime Id": {
            "description": "Runtime block state ID associated with this item when it represents a block.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 3
        },
        "Id": {
            "description": "Item id (network varint). Send fixed Id of 0 for invalid item.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 0,
            "minimum": -32768.0,
            "maximum": 32767.0
        },
        "Stack size": {
            "description": "The number of items in the stack.",
            "type": "integer",
            "x-underlying-type": "uint16",
            "x-ordinal-index": 1,
            "minimum": 0.0,
            "maximum": 64.0
        },
        "User Data Buffer": {
            "description": "The item user data binary blob encoded as a String.",
            "type": "string",
            "x-ordinal-index": 4
        }
    },
    "required": [
        "Aux value",
        "Block Runtime Id",
        "Id",
        "Stack size",
        "User Data Buffer"
    ]
}