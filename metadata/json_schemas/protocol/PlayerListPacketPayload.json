{
    "title": "PlayerListPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/PlayerListPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Entries": {
            "description": "List of player-list updates. Each entry is a discriminated variant: an Add entry carries the full PlayerListEntry payload; a Remove entry carries only the UUID. The variant alternative is identified by the per-entry \"Action\" tag.",
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "$ref": "./PlayerListRemoveEntry.json"
                    },
                    {
                        "$ref": "./PlayerListAddEntry.json"
                    }
                ],
                "x-control-value-type": "uint32"
            },
            "x-ordinal-index": 0,
            "maxItems": 1000
        }
    }
}