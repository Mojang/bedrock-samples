{
    "title": "InventoryAction",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/InventoryAction.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "From Item": {
            "description": "The item descriptor representing the state of the slot before this action.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 2
        },
        "Slot": {
            "description": "The slot index within the source container.",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 1,
            "minimum": 0.0
        },
        "Source": {
            "description": "The inventory source identifying which container this action targets.",
            "$ref": "./InventorySource.json",
            "x-ordinal-index": 0
        },
        "To Item": {
            "description": "The item descriptor representing the desired state of the slot after this action.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "From Item",
        "Slot",
        "Source",
        "To Item"
    ]
}