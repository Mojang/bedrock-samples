{
    "title": "ChangePlayerScore",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ChangePlayerScore.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Action": {
            "const": "changeplayer",
            "$ref": "./ScorePacketEntryAction.json",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 0
        },
        "Objective Name": {
            "description": "Name of the objective whose score is being changed.",
            "type": "string",
            "x-ordinal-index": 2,
            "minLength": 1
        },
        "Player Unique Id": {
            "description": "Unique ID of the player this score is for.",
            "$ref": "./PlayerScoreboardId.json",
            "x-ordinal-index": 4
        },
        "Score Value": {
            "description": "The new score value.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-ordinal-index": 3
        },
        "Scoreboard Id": {
            "description": "Scoreboard entry identifier this score belongs to.",
            "$ref": "./ScoreboardId.json",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "Action",
        "Objective Name",
        "Player Unique Id",
        "Score Value",
        "Scoreboard Id"
    ]
}