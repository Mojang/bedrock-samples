{
    "title": "PackInfoData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/PackInfoData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "CDN URL": {
            "description": "Optional CDN URL the client may download the pack from.",
            "type": "string",
            "x-ordinal-index": 8
        },
        "Content Identity": {
            "description": "Marketplace content identity for the pack.",
            "$ref": "./ContentIdentity.json",
            "x-ordinal-index": 4
        },
        "Content Key": {
            "description": "Decryption key for the pack's encrypted content.",
            "type": "string",
            "x-ordinal-index": 2
        },
        "Has Scripts": {
            "description": "Whether this pack contains client scripts.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 5
        },
        "Is Addon Pack": {
            "description": "Whether this pack is an add-on pack.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 6
        },
        "Is Ray Tracing Capable": {
            "description": "Whether this pack provides ray-tracing assets.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 7
        },
        "Pack Id Version": {
            "description": "The pack's UUID and semantic version.",
            "$ref": "./PackIdVersion.json",
            "x-ordinal-index": 0
        },
        "Pack Size": {
            "description": "Size of the pack in bytes.",
            "type": "integer",
            "x-underlying-type": "uint64",
            "x-ordinal-index": 1,
            "minimum": 0.0
        },
        "Subpack Name": {
            "description": "Name of the selected subpack, if any.",
            "type": "string",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "CDN URL",
        "Content Identity",
        "Content Key",
        "Has Scripts",
        "Is Addon Pack",
        "Is Ray Tracing Capable",
        "Pack Id Version",
        "Pack Size",
        "Subpack Name"
    ]
}