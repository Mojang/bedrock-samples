{
    "title": "CreativeItemEntryPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CreativeItemEntryPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Creative Net Id": {
            "$ref": "./CreativeItemNetId.json",
            "x-ordinal-index": 0
        },
        "Group Index": {
            "description": "Zero-based index into the Groups list above, identifying which group this item belongs to. The reserved sentinel value 0xFFFFFFFF (uint32 max, CreativeItemRegistry::INVALID_INDEX) indicates the item has no group and should appear ungrouped in the creative inventory.",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2,
            "minimum": 0.0
        },
        "Item Instance": {
            "$ref": "./NetworkItemInstanceDescriptor.json",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "Creative Net Id",
        "Group Index",
        "Item Instance"
    ]
}