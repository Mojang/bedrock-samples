{
    "title": "RecipeUnlockingRequirement",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/RecipeUnlockingRequirement.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Unlocking Context": {
            "$ref": "./RecipeUnlockingContext.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 0
        },
        "Unlocking Ingredients": {
            "description": "Optional list of ingredients required to unlock the recipe. Only populated when Unlocking Context is None; otherwise the recipe is unlocked by the context condition and no ingredients are transmitted.",
            "type": "array",
            "items": {
                "$ref": "./RecipeIngredient.json"
            },
            "x-ordinal-index": 1,
            "maxItems": 128
        }
    },
    "required": [
        "Unlocking Context"
    ]
}