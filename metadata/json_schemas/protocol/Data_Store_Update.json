{
    "title": "Data Store Update",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/Data_Store_Update.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Data": {
            "description": "The value that is updating",
            "oneOf": [
                {
                    "type": "number",
                    "x-underlying-type": "double",
                    "x-ordinal-index": 0
                },
                {
                    "type": "boolean",
                    "x-underlying-type": "boolean",
                    "x-ordinal-index": 1
                },
                {
                    "type": "string",
                    "x-ordinal-index": 2,
                    "maxLength": 5000
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 3
        },
        "Data Store Name": {
            "type": "string",
            "x-ordinal-index": 0,
            "minLength": 1,
            "maxLength": 1000
        },
        "Path": {
            "description": "The path through the property that needs updating",
            "type": "string",
            "x-ordinal-index": 2,
            "maxLength": 1000
        },
        "Path Update Count": {
            "description": "The number of times this path has updated. Resets if the entire property has changed.",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 5,
            "minimum": 0.0,
            "maximum": 4294967294.0
        },
        "Property": {
            "description": "The name of the property in the data store that has changed",
            "type": "string",
            "x-ordinal-index": 1,
            "minLength": 1,
            "maxLength": 1000
        },
        "Property Update Count": {
            "description": "The number of times this property has updated. Does not increment unless the entire property updates",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 4,
            "minimum": 0.0,
            "maximum": 4294967294.0
        }
    },
    "required": [
        "Data",
        "Data Store Name",
        "Path",
        "Path Update Count",
        "Property",
        "Property Update Count"
    ]
}