{
    "title": "ItemStackRequest",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ItemStackRequest.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Actions": {
            "description": "Action list. Each entry starts with an ItemStackRequestActionType byte followed by that action's payload.",
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "$ref": "./ItemStackRequestTakeAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestPlaceAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestSwapAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestDropAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestDestroyAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestConsumeAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCreateAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestLabTableCombineAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestBeaconPaymentAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestMineBlockAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftRecipeAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftRecipeAutoAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftCreativeAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftRecipeOptionalAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftRepairAndDisenchantAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftLoomAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftNonImplementedDeprecatedAction.json"
                    },
                    {
                        "$ref": "./ItemStackRequestCraftResultsDeprecatedAction.json"
                    }
                ],
                "x-control-value-type": "uint32"
            },
            "x-ordinal-index": 1,
            "minItems": 1,
            "maxItems": 100
        },
        "Client Request Id": {
            "$ref": "./ItemStackRequestId.json",
            "x-ordinal-index": 0,
            "x-runtime-constraint-description": "Verify the request id is a valid negative odd client request id"
        },
        "Strings To Filter": {
            "description": "Array of strings to submit to profanity filtering service",
            "type": "array",
            "items": {
                "type": "string",
                "maxLength": 1000
            },
            "x-ordinal-index": 2
        },
        "StringsToFilterOrigin": {
            "$ref": "./TextProcessingEventOrigin.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Actions",
        "Client Request Id",
        "Strings To Filter",
        "StringsToFilterOrigin"
    ]
}