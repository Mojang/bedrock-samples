{
    "title": "SubChunkHeightmapData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/SubChunkHeightmapData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Height Map Type": {
            "description": "Type of height map data for this subchunk.",
            "type": "string",
            "enum": [
                "NoData",
                "HasData",
                "AllTooHigh",
                "AllTooLow"
            ],
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 0
        },
        "Render Height Map Type": {
            "description": "Type of render height map data for this subchunk.",
            "type": "string",
            "enum": [
                "NoData",
                "HasData",
                "AllTooHigh",
                "AllTooLow",
                "AllCopied"
            ],
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 2
        },
        "Subchunk Height Map": {
            "description": "2D height map array [z][x], present when type is HasData.",
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "integer",
                    "x-underlying-type": "int8",
                    "minimum": -128.0,
                    "maximum": 127.0
                },
                "minItems": 16,
                "maxItems": 16
            },
            "x-ordinal-index": 1,
            "minItems": 16,
            "maxItems": 16
        },
        "Subchunk Render Height Map": {
            "description": "2D render height map array [z][x], present when type is HasData.",
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "integer",
                    "x-underlying-type": "int8",
                    "minimum": -128.0,
                    "maximum": 127.0
                },
                "minItems": 16,
                "maxItems": 16
            },
            "x-ordinal-index": 3,
            "minItems": 16,
            "maxItems": 16
        }
    },
    "required": [
        "Height Map Type",
        "Render Height Map Type"
    ]
}