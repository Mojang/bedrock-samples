{
    "title": "MobEquipmentPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/MobEquipmentPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Container ID": {
            "description": "Identifies which container the item belongs to, e.g. inventory or offhand.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 4,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Item": {
            "description": "The item stack being equipped. Send an empty descriptor to indicate no item.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 1
        },
        "Selected Slot": {
            "description": "The hotbar slot that is currently selected by the player. Matches Slot for non-player mobs.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 3,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Slot": {
            "description": "The inventory slot index the item occupies within the container.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Target Runtime ID": {
            "description": "Runtime ID of the mob or player whose equipment is changing.",
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Container ID",
        "Item",
        "Selected Slot",
        "Slot",
        "Target Runtime ID"
    ]
}