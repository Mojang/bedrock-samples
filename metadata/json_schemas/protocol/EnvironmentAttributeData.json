{
    "title": "EnvironmentAttributeData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/EnvironmentAttributeData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Attribute": {
            "oneOf": [
                {
                    "$ref": "./BoolAttributeData.json"
                },
                {
                    "$ref": "./FloatAttributeData.json"
                },
                {
                    "$ref": "./ColorAttributeData.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 2
        },
        "AttributeName": {
            "type": "string",
            "x-ordinal-index": 0,
            "maxLength": 128
        },
        "CurrentTransitionTicks": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 4,
            "minimum": 0.0
        },
        "Easing": {
            "$ref": "./easing_function.json",
            "x-underlying-type": "int32",
            "x-ordinal-index": 6
        },
        "FromAttribute": {
            "oneOf": [
                {
                    "$ref": "./BoolAttributeData.json"
                },
                {
                    "$ref": "./FloatAttributeData.json"
                },
                {
                    "$ref": "./ColorAttributeData.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 1
        },
        "LocalTransitionTicks": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 7,
            "minimum": 0.0
        },
        "NoiseTransition": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 8
        },
        "ToAttribute": {
            "oneOf": [
                {
                    "$ref": "./BoolAttributeData.json"
                },
                {
                    "$ref": "./FloatAttributeData.json"
                },
                {
                    "$ref": "./ColorAttributeData.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 3
        },
        "TotalTransitionTicks": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 5,
            "minimum": 0.0
        }
    },
    "required": [
        "Attribute",
        "AttributeName",
        "CurrentTransitionTicks",
        "Easing",
        "LocalTransitionTicks",
        "NoiseTransition",
        "TotalTransitionTicks"
    ]
}