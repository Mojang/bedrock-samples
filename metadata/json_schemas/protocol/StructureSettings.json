{
    "title": "StructureSettings",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/StructureSettings.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Animation Mode": {
            "$ref": "./AnimationMode.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 9
        },
        "Animation Seconds": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 10
        },
        "Integrity Seed": {
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 12,
            "minimum": 0.0
        },
        "Integrity Value": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 11
        },
        "Last Edit Player": {
            "description": "Player who last edited the structure block.",
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 6
        },
        "Mirror": {
            "$ref": "./Mirror.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 8
        },
        "Rotation": {
            "$ref": "./Rotation.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 7
        },
        "Rotation Pivot": {
            "description": "Pivot used to rotate a structure around.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 13
        },
        "Should Allow Non Ticking Player and Ticking Area Chunks": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 3
        },
        "Should ignore blocks?": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 2
        },
        "Should ignore entities?": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 1
        },
        "Structure Offset": {
            "$ref": "./BlockPos.json",
            "x-ordinal-index": 5
        },
        "Structure Palette Name": {
            "type": "string",
            "x-ordinal-index": 0,
            "maxLength": 256
        },
        "Structure Size": {
            "$ref": "./BlockPos.json",
            "x-ordinal-index": 4
        }
    },
    "required": [
        "Animation Mode",
        "Animation Seconds",
        "Integrity Seed",
        "Integrity Value",
        "Last Edit Player",
        "Mirror",
        "Rotation",
        "Rotation Pivot",
        "Should Allow Non Ticking Player and Ticking Area Chunks",
        "Should ignore blocks?",
        "Should ignore entities?",
        "Structure Offset",
        "Structure Palette Name",
        "Structure Size"
    ]
}