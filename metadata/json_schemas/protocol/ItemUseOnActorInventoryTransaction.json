{
    "title": "ItemUseOnActorInventoryTransaction",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ItemUseOnActorInventoryTransaction.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Action Type": {
            "description": "Interact: right-click on actor. Attack: left-click or trident spin attack.",
            "$ref": "./ItemUseOnActorActionType.json",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 2
        },
        "Actions": {
            "description": "Base inventory actions. Lists the inventory slot changes associated with this transaction.",
            "$ref": "./InventoryTransaction.json",
            "x-ordinal-index": 0
        },
        "From Position": {
            "description": "The player's position when this transaction was sent.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 5
        },
        "Hit Position": {
            "description": "The position on the actor that was clicked.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 6
        },
        "Item": {
            "description": "The item stack descriptor of the item being used on the actor.",
            "$ref": "./NetworkItemStackDescriptor.json",
            "x-ordinal-index": 4
        },
        "Runtime Id": {
            "description": "The runtime ID of the actor being interacted with or attacked.",
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 1
        },
        "Slot": {
            "description": "The inventory slot of the item being used on the actor.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Action Type",
        "Actions",
        "From Position",
        "Hit Position",
        "Item",
        "Runtime Id",
        "Slot"
    ]
}