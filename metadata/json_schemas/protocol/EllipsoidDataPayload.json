{
    "title": "EllipsoidDataPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/EllipsoidDataPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Radii": {
            "description": "Radii (X, Y, Z) of the debug ellipsoid.",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 0
        },
        "Segments Per Axis": {
            "description": "Number of segments per axis used for the debug ellipsoid.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 1,
            "minimum": 0.0,
            "maximum": 255.0
        }
    },
    "required": [
        "Radii",
        "Segments Per Axis"
    ]
}