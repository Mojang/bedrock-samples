{
    "title": "SubChunkPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/SubChunkPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Cache Enabled": {
            "description": "Whether client supports blob caching.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 0
        },
        "Center Pos": {
            "description": "The centroid of the subchunk positions for translating relative to absolute.",
            "$ref": "./SubChunkPos.json",
            "x-ordinal-index": 2
        },
        "Dimension Type": {
            "description": "The dimension where the subchunk data belongs.",
            "$ref": "./DimensionType.json",
            "x-ordinal-index": 1
        },
        "SubChunk Data": {
            "description": "Collection of subchunk data entries.",
            "type": "array",
            "items": {
                "$ref": "./SubChunkPacketData.json"
            },
            "x-ordinal-index": 3,
            "maxItems": 8192
        }
    },
    "required": [
        "Cache Enabled",
        "Center Pos",
        "Dimension Type",
        "SubChunk Data"
    ]
}