{
    "title": "BiomeDefinitionData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/BiomeDefinitionData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "chunk gen data": {
            "description": "Only used with client-side chunk generation",
            "$ref": "./BiomeDefinitionChunkGenData.json",
            "x-ordinal-index": 9
        },
        "depth": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 4
        },
        "downfall": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 2
        },
        "foliage snow": {
            "description": "0-1 how frozen the leaves look",
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 3
        },
        "id": {
            "type": "integer",
            "x-underlying-type": "uint16",
            "x-ordinal-index": 0,
            "minimum": 0.0
        },
        "map water color ARGB": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-ordinal-index": 6
        },
        "rain": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 7
        },
        "scale": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 5
        },
        "tags": {
            "$ref": "./BiomeTagsData.json",
            "x-ordinal-index": 8
        },
        "temperature": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1
        }
    },
    "required": [
        "chunk gen data",
        "depth",
        "downfall",
        "foliage snow",
        "id",
        "map water color ARGB",
        "rain",
        "scale",
        "tags",
        "temperature"
    ]
}