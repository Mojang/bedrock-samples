{
    "title": "ItemStackResponseSlotInfo",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ItemStackResponseSlotInfo.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Amount": {
            "description": "The item amount in the slot. When zero, the Item Stack Net Id optional carries no value (a single presence byte of 0 is still written).",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 2,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Custom Name": {
            "description": "The custom name of the item.",
            "$ref": "./Bedrock__Safety__RedactableString.json",
            "x-ordinal-index": 4
        },
        "Durability Correction": {
            "description": "Durability correction value, encoded as a zigzag VarInt32 on the wire. Must fit in an int16_t.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 5,
            "minimum": -32768.0,
            "maximum": 32767.0
        },
        "Item Stack Net Id": {
            "description": "The server net ID for the item stack. Encoded as an optional: a presence byte is always written, followed by the value only when Amount > 0.",
            "$ref": "./ItemStackNetId.json",
            "x-ordinal-index": 3
        },
        "Requested Slot": {
            "description": "The slot index that was requested.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 0,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Slot": {
            "description": "The actual slot index.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 1,
            "minimum": 0.0,
            "maximum": 255.0
        }
    },
    "required": [
        "Amount",
        "Custom Name",
        "Durability Correction",
        "Requested Slot",
        "Slot"
    ]
}