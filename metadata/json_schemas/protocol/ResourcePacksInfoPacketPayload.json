{
    "title": "ResourcePacksInfoPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ResourcePacksInfoPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Force Disable Vibrant Visuals": {
            "description": "Forces Vibrant Visuals (deferred rendering) off for this session.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 3
        },
        "Has Addon Packs": {
            "description": "Whether any of the resource packs are add-on packs.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 1
        },
        "Has Scripts": {
            "description": "Whether any of the resource packs contain client scripts.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 2
        },
        "Resource Pack Required": {
            "description": "Whether the client must apply the server's resource packs to join.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 0
        },
        "Resource Packs": {
            "description": "The resource packs the client needs for this world.",
            "type": "array",
            "items": {
                "$ref": "./PackInfoData.json"
            },
            "x-ordinal-index": 5,
            "maxItems": 65535
        },
        "World Template Id And Version": {
            "description": "UUID and version of the world template this world is based on, if any.",
            "$ref": "./PackIdVersion.json",
            "x-ordinal-index": 4
        }
    },
    "required": [
        "Force Disable Vibrant Visuals",
        "Has Addon Packs",
        "Has Scripts",
        "Resource Pack Required",
        "Resource Packs",
        "World Template Id And Version"
    ]
}