{
    "title": "LevelChunkPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/LevelChunkPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "Cache Enabled": {
            "description": "Whether the client cache (blob) protocol is used for this chunk.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 4
        },
        "Cache Metadata": {
            "description": "Per-sub-chunk cache blob hashes; populated only when Cache Enabled is set.",
            "type": "array",
            "items": {
                "$ref": "./LevelChunkPacketPayload_SubChunkMetadata.json"
            },
            "x-ordinal-index": 5,
            "maxItems": 65
        },
        "Chunk Position": {
            "description": "Chunk column position (chunk x, chunk z).",
            "$ref": "./ChunkPos.json",
            "x-ordinal-index": 0
        },
        "Client Request SubChunk Limit": {
            "description": "Optional client sub-chunk request limit; -1 means no limit. Present only in request mode.",
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 3,
            "minimum": -1.0,
            "maximum": 64.0
        },
        "Dimension Id": {
            "description": "Dimension the chunk belongs to.",
            "$ref": "./DimensionType.json",
            "x-ordinal-index": 1
        },
        "Serialized Chunk Data": {
            "description": "The serialized chunk payload (block, biome, heightmap and block-entity data).",
            "type": "string",
            "x-ordinal-index": 6
        },
        "Sub-chunks Count": {
            "description": "Number of sub-chunks serialized in this packet.",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 2,
            "minimum": 0.0,
            "maximum": 64.0
        }
    },
    "required": [
        "Cache Enabled",
        "Cache Metadata",
        "Chunk Position",
        "Dimension Id",
        "Serialized Chunk Data",
        "Sub-chunks Count"
    ]
}