{
    "title": "MoveActorAbsoluteData",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/MoveActorAbsoluteData.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.40-beta.0",
    "x-protocol-version": 2168,
    "type": "object",
    "properties": {
        "ActorRuntimeID": {
            "description": "The runtime id of the actor being moved",
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 0
        },
        "Header": {
            "description": "Header bits describing the status of the actor, see additional documentation in the supplemental documentation folder",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 1,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Position": {
            "description": "X/Y/Z coordinates of the position of the actor, each being a 4 byte float",
            "$ref": "./Vec3.json",
            "x-ordinal-index": 2
        },
        "Rotation X": {
            "description": "The X rotation of the actor stored as an integer",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 3,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Rotation Y": {
            "description": "The Y rotation of the actor stored as an integer",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 4,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Rotation Y Head": {
            "description": "The head rotation of the actor if and only if it's a Mob type, stored as an integer",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 5,
            "minimum": 0.0,
            "maximum": 255.0
        }
    },
    "required": [
        "ActorRuntimeID",
        "Header",
        "Position",
        "Rotation X",
        "Rotation Y",
        "Rotation Y Head"
    ]
}