{
  "$id": "/client_server/world/1.21.20/AxisAlignedLinear.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Predicate that evalutes to true if the block is within the distance range along the provided axis and and random number is generated between chance range",
  "properties": {
    "axis": {
      "$ref": "./PositionalBlockRuleAxis.json",
      "default": "y",
      "x-ordinal-index": 5,
      "x-underlying-type": "uint8"
    },
    "max_chance": {
      "default": 0,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "type": "number",
      "x-ordinal-index": 2,
      "x-underlying-type": "float"
    },
    "max_dist": {
      "default": 0,
      "minimum": 0,
      "type": "integer",
      "x-ordinal-index": 3,
      "x-underlying-type": "int32"
    },
    "min_chance": {
      "default": 0,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "type": "number",
      "x-ordinal-index": 1,
      "x-underlying-type": "float"
    },
    "min_dist": {
      "default": 0,
      "minimum": 0,
      "type": "integer",
      "x-ordinal-index": 4,
      "x-underlying-type": "int32"
    },
    "predicate_type": {
      "$ref": "./PosType.json",
      "const": "minecraft:axis_aligned_linear_pos",
      "x-ordinal-index": 0,
      "x-underlying-type": "uint8"
    }
  },
  "required": [
    "predicate_type"
  ],
  "title": "AxisAlignedLinear",
  "type": "object",
  "x-format-version": "1.21.20"
}