{
  "$id": "/client_server/world/1.21.20/RandomBlockStateMatch.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Predicate that evaluates to true with a given probability if the block at the specified location matches the specified block.",
  "properties": {
    "block_state": {
      "$ref": "../../common/1.21.20/Block%20Specifier.json",
      "description": "The block state to match against.",
      "x-ordinal-index": 1
    },
    "predicate_type": {
      "$ref": "./BlockType.json",
      "const": "minecraft:random_blockstate_match",
      "x-ordinal-index": 0,
      "x-underlying-type": "uint8"
    },
    "probability": {
      "description": "Probability of the evaluating to true when the block matches.",
      "maximum": 1,
      "minimum": 0,
      "type": "number",
      "x-ordinal-index": 2,
      "x-underlying-type": "float"
    }
  },
  "required": [
    "block_state",
    "predicate_type",
    "probability"
  ],
  "title": "RandomBlockStateMatch",
  "type": "object",
  "x-format-version": "1.21.20"
}