{
  "$id": "/client_server/common/1.21.20/Block%20Specifier.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Specifies a particular block. Can be a string block name or a JSON object",
  "oneOf": [
    {
      "$ref": "../legacy/Reference%200.json"
    },
    {
      "properties": {
        "name": {
          "$ref": "../legacy/Reference%200.json",
          "description": "Name of the block",
          "x-ordinal-index": 0
        },
        "states": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer",
                "x-ordinal-index": 0,
                "x-underlying-type": "int32"
              },
              {
                "type": "boolean",
                "x-ordinal-index": 1,
                "x-underlying-type": "boolean"
              },
              {
                "type": "string",
                "x-ordinal-index": 2
              }
            ],
            "x-control-value-type": "uint32"
          },
          "default": {
          },
          "description": "Contains members named after each state, with boolean, integer, or string values.",
          "type": "object",
          "x-ordinal-index": 1
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  ],
  "title": "Block Specifier",
  "x-format-version": "1.21.20"
}