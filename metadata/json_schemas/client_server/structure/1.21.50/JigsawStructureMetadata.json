{
  "$id": "/client_server/structure/1.21.50/JigsawStructureMetadata.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "markers": {
      "description": "The Jigsaw blocks contained within the generated structure.",
      "items": {
        "$ref": "./JigsawBlockMetadata.json"
      },
      "type": "array",
      "x-ordinal-index": 2
    },
    "size": {
      "$ref": "./block_pos.json",
      "description": "The generated structures bounding size.",
      "x-ordinal-index": 0
    },
    "use_legacy_rotation": {
      "default": false,
      "description": "Unused - Previously if true would use legacy size rotation.",
      "type": "boolean",
      "x-ordinal-index": 1,
      "x-underlying-type": "boolean"
    }
  },
  "required": [
    "markers",
    "size"
  ],
  "title": "JigsawStructureMetadata",
  "type": "object",
  "x-format-version": "1.21.50"
}