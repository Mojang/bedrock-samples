{
  "$id": "/client_server/packaging/3.0.0/DropdownSetting.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "default": {
      "minLength": 1,
      "type": "string",
      "x-ordinal-index": 4
    },
    "name": {
      "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$",
      "type": "string",
      "x-ordinal-index": 1,
      "x-regex-flags": "ECMAScript,icase"
    },
    "options": {
      "items": {
        "$ref": "./DropdownOption.json"
      },
      "maxItems": 20,
      "minItems": 2,
      "type": "array",
      "x-ordinal-index": 3
    },
    "text": {
      "type": "string",
      "x-ordinal-index": 2
    },
    "type": {
      "$ref": "./SettingType.json",
      "x-ordinal-index": 0,
      "x-underlying-type": "uint8"
    }
  },
  "required": [
    "default",
    "name",
    "options",
    "text",
    "type"
  ],
  "title": "DropdownSetting",
  "type": "object",
  "x-format-version": "3.0.0"
}