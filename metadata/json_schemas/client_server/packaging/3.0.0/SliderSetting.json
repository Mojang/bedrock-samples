{
  "$id": "/client_server/packaging/3.0.0/SliderSetting.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "default": {
      "type": "number",
      "x-ordinal-index": 6,
      "x-underlying-type": "float"
    },
    "max": {
      "type": "number",
      "x-ordinal-index": 4,
      "x-underlying-type": "float"
    },
    "min": {
      "type": "number",
      "x-ordinal-index": 3,
      "x-underlying-type": "float"
    },
    "name": {
      "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$",
      "type": "string",
      "x-ordinal-index": 1,
      "x-regex-flags": "ECMAScript,icase"
    },
    "step": {
      "exclusiveMinimum": 0,
      "type": "number",
      "x-ordinal-index": 5,
      "x-underlying-type": "float"
    },
    "text": {
      "type": "string",
      "x-ordinal-index": 2
    },
    "type": {
      "$ref": "./SettingType.json",
      "x-ordinal-index": 0,
      "x-underlying-type": "uint8"
    }
  },
  "required": [
    "default",
    "max",
    "min",
    "name",
    "step",
    "text",
    "type"
  ],
  "title": "SliderSetting",
  "type": "object",
  "x-format-version": "3.0.0"
}