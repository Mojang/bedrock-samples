{
  "$id": "/client_server/packaging/3.0.0/Header.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "allow_random_seed": {
      "type": "boolean",
      "x-ordinal-index": 8,
      "x-underlying-type": "boolean"
    },
    "base_game_version": {
      "type": "string",
      "x-ordinal-index": 5
    },
    "description": {
      "type": "string",
      "x-ordinal-index": 1
    },
    "lock_template_options": {
      "type": "boolean",
      "x-ordinal-index": 9,
      "x-underlying-type": "boolean"
    },
    "min_engine_version": {
      "type": "string",
      "x-ordinal-index": 4
    },
    "name": {
      "minLength": 1,
      "type": "string",
      "x-ordinal-index": 0
    },
    "pack_optimization_version": {
      "$ref": "./RelaxedSemVersion.json",
      "x-ordinal-index": 10
    },
    "pack_scope": {
      "type": "string",
      "x-ordinal-index": 6
    },
    "platform_locked": {
      "type": "boolean",
      "x-ordinal-index": 7,
      "x-underlying-type": "boolean"
    },
    "uuid": {
      "$ref": "./UUID.json",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "x-ordinal-index": 2
    },
    "version": {
      "$ref": "./SemVersion.json",
      "x-ordinal-index": 3
    }
  },
  "required": [
    "name",
    "uuid",
    "version"
  ],
  "title": "Header",
  "type": "object",
  "x-format-version": "3.0.0"
}