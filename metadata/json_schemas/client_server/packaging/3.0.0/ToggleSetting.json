{
  "$id": "/client_server/packaging/3.0.0/ToggleSetting.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "default": {
      "type": "boolean",
      "x-ordinal-index": 3,
      "x-underlying-type": "boolean"
    },
    "name": {
      "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$",
      "type": "string",
      "x-ordinal-index": 1,
      "x-regex-flags": "ECMAScript,icase"
    },
    "text": {
      "type": "string",
      "x-ordinal-index": 2
    },
    "type": {
      "$ref": "./SettingType.json",
      "x-ordinal-index": 0,
      "x-underlying-type": "uint8"
    }
  },
  "required": [
    "default",
    "name",
    "text",
    "type"
  ],
  "title": "ToggleSetting",
  "type": "object",
  "x-format-version": "3.0.0"
}