{
  "$id": "/server/biome/1.26.30/NoiseBlockSpecifier.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "block": {
      "$ref": "../../../client_server/common/1.21.20/Block%20Specifier.json",
      "description": "The block to place if the noise sample satisfies the provided threshold/range",
      "x-ordinal-index": 3
    },
    "noise": {
      "default": "",
      "description": "The string identifier of the noise associated with this NoiseBlockSpecifier.",
      "pattern": "^\\S+$",
      "type": "string",
      "x-ordinal-index": 0,
      "x-regex-flags": "ECMAScript,icase"
    },
    "range": {
      "$ref": "../../../client_server/common/legacy/FloatRange.json",
      "default": {
        "max": 0,
        "min": 0
      },
      "description": "The range of sampled noise value associated with the provided Block.",
      "x-ordinal-index": 2
    },
    "threshold": {
      "default": 0,
      "description": "The minimum sampled noise value associated with the provided Block.",
      "type": "number",
      "x-ordinal-index": 1,
      "x-underlying-type": "float"
    }
  },
  "required": [
    "block"
  ],
  "title": "NoiseBlockSpecifier",
  "type": "object",
  "x-format-version": "1.26.30"
}