{
  "$id": "/server/block/1.26.20/Blocks.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "components": {
      "$ref": "./Components.json",
      "propertyNames": {
        "pattern": "^(?!(minecraft:on_interact|minecraft:breathability|minecraft:unit_cube|minecraft:on_fall_on|minecraft:on_placed|minecraft:on_player_destroyed|minecraft:on_player_placing|minecraft:on_step_off|minecraft:on_step_on|minecraft:queued_ticking|minecraft:random_ticking)$)",
        "type": "string"
      },
      "x-ordinal-index": 1,
      "x-runtime-constraint-description": "Block cannot have both \"minecraft:redstone_producer\" and \"minecraft:redstone_consumer\" components."
    },
    "description": {
      "$ref": "./Description.json",
      "description": "Information about the block, must have at minimum an \"identifier\" and can have also the following optional field \"menu_category\", \"states\" and/or \"traits\"",
      "x-ordinal-index": 0
    },
    "permutations": {
      "default": [
      ],
      "items": {
        "$ref": "./Permutation.json"
      },
      "type": "array",
      "x-ordinal-index": 2
    }
  },
  "required": [
    "description"
  ],
  "title": "BlockDefinitionDocument",
  "type": "object",
  "x-format-version": "1.26.20"
}