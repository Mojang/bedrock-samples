{
  "$id": "/server/sound/beta/Server%20Sound%20Definition.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A single server-authoritative sound definition.",
  "properties": {
    "duration_info": {
      "$ref": "./Server%20Sound%20Duration%20Info.json",
      "description": "Optional server-authoritative duration metadata.",
      "x-ordinal-index": 1
    },
    "music_info": {
      "$ref": "./Server%20Sound%20Music%20Info.json",
      "description": "Optional music metadata.",
      "x-ordinal-index": 2
    },
    "sound_event_name": {
      "description": "The namespaced sound event ID used to play this sound.",
      "pattern": "^\\S+$",
      "type": "string",
      "x-ordinal-index": 0,
      "x-regex-flags": "ECMAScript,icase"
    },
    "tags": {
      "additionalProperties": {
        "$ref": "./Server%20Sound%20Tag%20Value%20List.json"
      },
      "description": "Optional pack-defined key-value tags. Each value may be a single string or an array of strings.",
      "propertyNames": {
        "pattern": "^\\S+$",
        "type": "string"
      },
      "type": "object",
      "x-ordinal-index": 3
    }
  },
  "required": [
    "sound_event_name"
  ],
  "title": "Server Sound Definition",
  "type": "object",
  "x-format-version": "beta"
}